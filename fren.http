Content-Type: application/json

{
  "productName": "Kitap",
  "amount": 250.00,
  "currency": "INVALID",
  "reason": "Okumak istiyorum",
  "cooldownHours": 24
}

> {%
    client.test("Geçersiz para birimi için 400 dönmeli", function () {
        client.assert(
            response.status === 400,
